# Copie para .env e preencha. Validadas no boot por src/shared/lib/env.ts.
# Nenhuma env é NEXT_PUBLIC_: consumidor de env é server-side, nada vira bundle.

# Supabase — client PostgREST nas rotas de API (obrigatórias)
# SUPABASE_API_KEY é a publishable key nova (sb_publishable_...), sucessora da
# anon key; roda sob as mesmas RLS.
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_API_KEY=sb_publishable_<chave>

# Postgres direto (T1.1) — migrations no pooler modo sessão; app/seed no transação
# DATABASE_URL=postgresql://usuario:senha@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://usuario:senha@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# W1 — obrigatórias só a partir de Better Auth (T1.2)
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<gere com: openssl rand -base64 32>
