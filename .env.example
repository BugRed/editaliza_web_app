# Copie para .env e preencha. Validadas no boot por src/shared/lib/env.ts.

# Supabase (hoje: client anon nas rotas de API) — obrigatórias
NEXT_PUBLIC_SUPABASE_URL=https://<projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chave-anon>

# Base absoluta para fetch server-side das páginas (opcional; default localhost:3000 em dev)
# NEXT_PUBLIC_BASE_URL=

# W1 — obrigatórias só a partir de Better Auth (T1.2) e Postgres direto (T1.1)
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<gere com: openssl rand -base64 32>
