{
  "name": "editaliza_plataforma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:setup": "node --env-file=.env.docker.example db/migrate.mjs && node --env-file=.env.docker.example db/seed.mjs && docker compose -f docker-compose.dev.yml exec -T db psql -U postgres -c \"NOTIFY pgrst, 'reload schema'\"",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:db:reset": "docker compose -f docker-compose.dev.yml down -v",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:docker": "docker compose -f docker-compose.test.yml run --rm --build test",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "csv-parse": "^7.0.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.539.0",
    "next": "15.5.27",
    "phosphor-icons": "^1.4.2",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "@tailwindcss/oxide@4.1.11": true,
    "sharp@0.34.3": true,
    "unrs-resolver@1.11.1": true
  }
}
