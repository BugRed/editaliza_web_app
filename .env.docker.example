# Banco local em Docker (docker-compose.dev.yml). Copie para .env.local: o Next carrega
# .env.local por cima do .env, então o Supabase da nuvem fica intacto. Apague .env.local para voltar.
SUPABASE_URL=http://localhost:54321
SUPABASE_API_KEY=local-dev-key
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgres://postgres:postgres@localhost:54322/postgres
