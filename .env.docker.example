# Banco local em Docker (docker-compose.dev.yml). Copie para .env.local: o Next carrega .env.local por cima
# do .env. Local é SEMPRE Docker; o mock em memória é só da produção (ver .env.example).
DATA_SOURCE=supabase
SUPABASE_URL=http://localhost:54321
SUPABASE_API_KEY=local-dev-key
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgres://postgres:postgres@localhost:54322/postgres
# Só para desenvolvimento local: nunca reutilize este valor fora da sua máquina.
AUTH_SECRET=dev-local-apenas-troque-fora-daqui-0123456789
