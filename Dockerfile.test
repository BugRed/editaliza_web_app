# Ambiente de teste isolado: nenhum teste roda no host nem toca serviço externo.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
# `npm install`, não `ci`: o lock gerado no host omite os pacotes opcionais @emnapi (wasm do
# oxide e do unrs-resolver) e o `npm ci` rejeita isso mesmo com o npm igual ao do host.
RUN npm install --no-audit --no-fund
COPY . .
CMD ["npm", "test"]
